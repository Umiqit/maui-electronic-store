<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MauiApp2_Lab2.AddCustomerPage"
             Title="Добавление покупателя">

    <!-- Стили результата валидации (ЛР6) -->
    <ContentPage.Resources>
        <Style x:Key="InvalidEntryStyle" TargetType="Entry">
            <Setter Property="TextColor" Value="Red" />
        </Style>
        <Style x:Key="ValidEntryStyle" TargetType="Entry">
            <Setter Property="TextColor" Value="Black" />
        </Style>
    </ContentPage.Resources>

    <VerticalStackLayout Spacing="10" Padding="20">

        <Label Text="ФИО"/>
        <Entry x:Name="NameEntry">
            <Entry.Behaviors>
                <toolkit:TextValidationBehavior
                    InvalidStyle="{StaticResource InvalidEntryStyle}"
                    ValidStyle="{StaticResource ValidEntryStyle}"
                    Flags="ValidateOnValueChanged"
                    MinimumLength="1"
                    MaximumLength="100"/>
            </Entry.Behaviors>
        </Entry>

        <Label Text="Электронная почта"/>
        <!-- Проверка шаблона e-mail: символы @ и точка (ЛР6) -->
        <Entry x:Name="EmailEntry" Placeholder="login@example.com">
            <Entry.Behaviors>
                <toolkit:TextValidationBehavior
                    InvalidStyle="{StaticResource InvalidEntryStyle}"
                    ValidStyle="{StaticResource ValidEntryStyle}"
                    Flags="ValidateOnValueChanged"
                    MinimumLength="1"
                    MaximumLength="120"
                    RegexPattern="^([\w\.\-]+)@([\w\-]+)((\.(\w){2,3})+)$"/>
            </Entry.Behaviors>
        </Entry>

        <Label Text="Телефон"/>
        <Entry x:Name="PhoneEntry" Keyboard="Telephone">
            <Entry.Behaviors>
                <toolkit:NumericValidationBehavior
                    InvalidStyle="{StaticResource InvalidEntryStyle}"
                    ValidStyle="{StaticResource ValidEntryStyle}"
                    Flags="ValidateOnValueChanged"/>
            </Entry.Behaviors>
        </Entry>

        <Button Text="Добавить" x:Name="AddCustomerButton" Clicked="AddCustomerButton_Clicked"/>
    </VerticalStackLayout>
</ContentPage>
